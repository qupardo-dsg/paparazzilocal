generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("reponedor")
  createdAt DateTime @default(now())
}

model Product {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  price     Int
  stock     Int
  sku       String   @unique
  image     String?
  disabled  Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt
}
